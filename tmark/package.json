{
  "name": "@tmark/tmark",
  "version": "0.1.0",
  "type": "module",
  "description": "Parser and serializer for TMark documents",
  "homepage": "https://github.com/waus/tmark-js#readme",
  "bugs": { "url": "https://github.com/waus/tmark-js/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waus/tmark-js.git",
    "directory": "tmark"
  },
  "publishConfig": { "access": "public" },
  "files": ["dist/tmark.js", "dist/*.d.ts"],
  "main": "./dist/tmark.js",
  "module": "./dist/tmark.js",
  "types": "./dist/tmark.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tmark.d.ts",
      "default": "./dist/tmark.js"
    },
    "./browser": "./dist/tmark.js"
  },
  "scripts": {
    "build": "tsc --declaration --emitDeclarationOnly --outDir dist && esbuild src/tmark.ts --bundle --format=esm --outfile=dist/tmark.js",
    "test": "npm run build && node test/fixtures.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
